# Copy this file to .env.local for local development and fill in real
# values there. .env.local is already in .gitignore — never commit it.
# On Vercel, set the same names under Project Settings -> Environment
# Variables instead of putting them in a file.

# A passcode you make up yourself. Required — the app refuses every AI
# call until this is set, even in local development. Keep it private;
# anyone with this deployment's URL and this passcode can use your AI quota.
APP_PASSCODE=

# Google AI Studio key (https://aistudio.google.com/apikey). Free tier.
# Free-tier content may be used by Google to improve its products — see
# the README's "AI providers and your data" section before sending
# anything sensitive through this key.
GEMINI_API_KEY=

# Extra free providers. Each is optional; any with a key is added to the
# fallback chain automatically. Check Settings -> AI providers after
# redeploying. Read each provider's data terms first (see README).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Mistral free Experiment plan (needs a verified phone number, no card).
MISTRAL_API_KEY=
# Cloudflare Workers AI needs BOTH of these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: live web search for current news and facts (tavily.com, free
# monthly credits). Unset = the assistant says web search is not set up.
TAVILY_API_KEY=
# Optional: force one model ID for a provider if its default is retired.
# GROQ_MODEL=
# OPENROUTER_MODEL=
# MISTRAL_MODEL=
# CLOUDFLARE_MODEL=

# Added in Milestone 3 (optional, paid) — leave blank unless you want it.
ANTHROPIC_API_KEY=
